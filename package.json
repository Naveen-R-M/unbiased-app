{
  "name": "unbiased-app",
  "version": "1.10.1",
  "description": "Unbiased desktop — Pareto-powered coding agent",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "node build/dev-launcher.cjs",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "dist": "electron-vite build && electron-builder --publish never",
    "test": "node --import tsx --test src/main/*.test.ts"
  },
  "build": {
    "appId": "ai.unbiased.desktop",
    "productName": "Unbiased",
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "files": [
      "out/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "LICENSE",
        "to": "licenses/unbiased/LICENSE"
      },
      {
        "from": "NOTICE",
        "to": "licenses/unbiased/NOTICE"
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "licenses/unbiased/THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "../unbiased-app-engine/dist/bundle",
        "to": "engine",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../unbiased-ax/dist",
        "to": "ax",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/skills",
        "to": "skills",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/icon.png",
        "to": "icon.png"
      }
    ],
    "asarUnpack": [
      "node_modules/@lydell/node-pty/**",
      "node_modules/@nut-tree-fork/libnut-darwin/**",
      "node_modules/@nut-tree-fork/node-mac-permissions/**",
      "node_modules/node-mac-permissions/**"
    ],
    "npmRebuild": false,
    "afterPack": "build/adhoc-sign.cjs",
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "icon": "resources/icon.png",
      "identity": null
    },
    "dmg": {
      "title": "Unbiased ${version}"
    }
  },
  "keywords": [],
  "license": "Apache-2.0",
  "type": "commonjs",
  "dependencies": {
    "@lydell/node-pty": "^1.2.0-beta.15",
    "@nut-tree-fork/nut-js": "^4.2.6",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "node-mac-permissions": "^2.5.0",
    "prismjs": "^1.30.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^7.3.6"
  },
  "allowScripts": {
    "electron@44.4.3": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "node-mac-permissions@2.5.0": true
  },
  "private": true
}
